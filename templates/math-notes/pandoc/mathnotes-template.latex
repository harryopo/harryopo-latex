% ============================================================
%  harryopo-mathnotes Pandoc LaTeX 模板
%  用法: pandoc input.md --template=pandoc/mathnotes-template.latex
%        --lua-filter=pandoc/mathnotes-table.lua -o output.pdf
% ============================================================
\documentclass{harryopo-mathnotes}

$if(title)$
\renewcommand{\mathtitle}{$title$}
$endif$
$if(author)$
\renewcommand{\mathauthor}{$author$}
$endif$
$if(date)$
\date{$date$}
$endif$

\begin{document}

% ===================== 封面 =====================
\newgeometry{top=3cm,bottom=2.5cm,left=4cm,right=4cm}
\maketitle
\thispagestyle{empty}
\cleardoublepage

% ===================== 目录 =====================
$if(toc)$
\setcounter{tocdepth}{2}
\tableofcontents
\cleardoublepage
$endif$

% ===================== 正文 =====================
\strictpagecheck
\setcounter{page}{1}
\restoregeometry
\onehalfspacing

$body$

\end{document}
