% fonts
\setmainfont{XITS}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic,Path=../fonts/]
\setmathfont{XITSMath}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold,Path=../fonts/]
\setsansfont{texgyreheros}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,ItalicFont=*-italic,BoldItalicFont=*-bolditalic,Path=../fonts/]
\setmonofont{lmmono10-regular}[Extension=.otf,Path=../fonts/]

\xeCJKsetup{AutoFallBack=true}
\setCJKmainfont[Extension=.TTF,BoldFont=FZHTJW,ItalicFont=FZKTJW,Path=../fonts/]{FZSSJW}
\setCJKfamilyfont{zhkai}[Extension=.TTF,Path=../fonts/]{FZKTJW}
\setCJKfamilyfont{zhfs}[Extension=.TTF,Path=../fonts/]{FZFSJW}
\setCJKfamilyfont{zhdbs}[Extension=.TTF,Path=../fonts/]{FZDBSJW}
\setCJKfamilyfont{zhxiaobiao}[Extension=.TTF,Path=../fonts/]{FZXBSJW}
\setCJKfamilyfont{zhhei}[Extension=.TTF,Path=../fonts/]{FZHTJW}

\newcommand{\fzkt}{\CJKfamily{zhkai}}
\newcommand{\fzfs}{\CJKfamily{zhfs}}
\newcommand{\fzdbs}{\CJKfamily{zhdbs}}
\newcommand{\fzxb}{\CJKfamily{zhxiaobiao}}
\newcommand{\fzht}{\CJKfamily{zhhei}}

% theorems
\theoremstyle{definition}
\newtheorem{definition}{定义}[section]
\newtheorem{theorem}{定理}[section]
\newtheorem{lemma}{引理}[section]
\newtheorem{corollary}{推论}[section]
\numberwithin{equation}{section}

% lst styles
\lstdefinestyle{pystyle}{language=Python,basicstyle=\ttfamily\small,numbers=left}
\lstdefinestyle{bashstyle}{language=bash,basicstyle=\ttfamily\small,numbers=left}
\lstdefinestyle{plainstyle}{basicstyle=\ttfamily\small,numbers=left}

% captions
\captionsetup{font=small,labelfont=bf,margin=10pt,format=hang}

% lengths
\setlength{\parindent}{2em}
\setstretch{1.25}
\tolerance=1000
\emergencystretch=3em

