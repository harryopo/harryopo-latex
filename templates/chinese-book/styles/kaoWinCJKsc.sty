%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% kaoWinCJKsc.sty — 方正字体配置 + 增强样式
% 字体规范：
%   最大标题：方正小标宋  |  次级标题：方正黑体
%   正文：方正书宋        |  其他板块：方正楷体
%   侧边注释：方正仿宋    |  代码：等宽代码字体
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\ProvidesPackage{kaoWinCJKsc}[2024/01/01 v2.0 FZ Font Config]

% ── 字体路径 ──
% 原为 C:/Windows/Fonts/ + GBK 名（方正书宋_GBK / FZHei-B01 …），
% 换机器即失效，且这些字体的**子集没有拉丁字形**——标题里的数字与英文
% 会整段变 null 空字符（实测 PDF 提取出上千个 \x00）。
% 统一指向项目内嵌字体 templates/fonts/，与 harryopo-base.sty 同一套。
\newcommand{\fontpath}{../fonts/}

% ⚠️ 不要给 \newCJKfontfamily 加 BoldFont/ItalicFont。
%   FZ*JW 系列没有独立的粗体/斜体字形，一旦声明 BoldFont=…，xeCJK 会去找
%   "TU/<族>/b/n" 形状并报 undefined，随后回退 nullfont——所有非 CJK 字符
%   （连字符、拉丁字母、数字）在 PDF 里变成 null 空字符。
%   实测：加上后 main.pdf 出现 1127 个 \x00；去掉后归零。
\newCJKfontfamily[Path=\fontpath, Extension=.TTF]\fzsong{FZSSJW}    %方正书宋
\newCJKfontfamily[Path=\fontpath, Extension=.TTF]\fzhei{FZHTJW}     %方正黑体
\newCJKfontfamily[Path=\fontpath, Extension=.TTF]\fzkai{FZKTJW}     %方正楷体
\newCJKfontfamily[Path=\fontpath, Extension=.TTF]\fzfs{FZFSJW}      %方正仿宋

% ── 方正小标宋（最大标题专用）──
\newCJKfontfamily[Path=\fontpath, Extension=.TTF]\fzxiaobiaosong{FZXBSJW}

% ── 方正黑体（标题用，别名 yh 兼容旧代码）──
\newCJKfontfamily[Path=\fontpath, Extension=.TTF]\yh{FZHTJW}

% ── 装饰字体（可选）：隶书项目内未内嵌，回退仿宋而非系统字体 ──
\newCJKfontfamily[Path=\fontpath, Extension=.TTF]\fzli{FZFSJW}
\newCJKfontfamily[Path=\fontpath, Extension=.ttf]\fzshti{FZShuTi-S05S}    %方正舒体  fzshti
\newCJKfontfamily[Path=\fontpath, Extension=.ttf]\fzyao{FZYaoTi-M06S}     %方正姚体  fzyao

% ── 备用系统字体 ──
\newCJKfontfamily\song{SimSun}                                 %宋体  song
\newCJKfontfamily\hei{SimHei}                                  %黑体  hei
\newCJKfontfamily\kai{KaiTi}                                   %楷体  kai
\newCJKfontfamily\fs{FangSong}                                %仿宋  fs

%----------------------------------------------------------------------------------------
% 等宽代码字体（公式/代码用，优先级：Cascadia Code > Consolas > Courier New）
\IfFontExistsTF{Cascadia Code}{%
    \setmonofont[Scale=MatchLowercase]{Cascadia Code}%
}{%
    \IfFontExistsTF{Consolas}{%
        \setmonofont[Scale=MatchLowercase]{Consolas}%
    }{%
        \setmonofont[Scale=MatchLowercase]{Courier New}%
    }%
}
%
% 边注字体：方正仿宋
\renewcommand*{\marginfont}{\fzfs\footnotesize\justifying\frenchspacing}

% ── 修正 @margin@par 中的 normalfont → fzfs ──
\renewcommand{\@margin@par}{%
    \justifying%
    \setlength{\RaggedRightParIndent}{0em}%
    \setlength{\parindent}{0em}%
    \setlength{\parskip}{0.5pc}%
    \frenchspacing%
    \fzfs% 方正仿宋
    \footnotesize%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 彩色盒子

\RequirePackage{tcolorbox}
\tcbuselibrary{breakable,skins,hooks,xparse}

\newcommand*\sideboxstyle[1]{%
    \ifstrequal{#1}{simple}{%
        \tikzstyle{boxstyle}=[%
        inner sep=2mm,
        ]%
    }{%
        \ifstrequal{#1}{kao}{%
            \tikzstyle{boxstyle}=[%
            inner sep=2mm,
            rounded corners,
            ]%
        }{%
            \PackageError{kao}{Unknown style given for sidebox: `#1`}{}
        }%
    }%
}

% kaobook 风格双线框
\sideboxstyle{kao}
\tcbset{kaobox/.style={
    enhanced,
    breakable,
    sharp corners,
    frame hidden,
    coltitle=black,
    fonttitle=\bfseries,
    boxrule=0pt,
    boxsep=0pt,
    left=4mm,
    right=2mm,
    top=2mm,
    bottom=2mm,
    borderline horizontal={0.5pt}{0pt}{black},
    borderline horizontal={0.5pt}{3pt}{black},
    attach boxed title to top center={yshift=-2.25mm},%yshift=-2.25mm
    boxed title style={boxrule=0pt,frame hidden,colback=white,left=2mm,right=2mm,top=1mm,bottom=1mm},
}}

\newtcolorbox{sidebox}[2][]{kaobox,title=#2,#1}
\newtcolorbox{sidebox*}[2][]{kaobox,title=#2,#1,float=htb}

\NewDocumentCommand{\solutions}{O{解答}}{%
    \tcbset{kaobox/.append style={borderline horizontal={0.5pt}{0pt}{black!50!white}}}%
    \begin{sidebox}{#1}
}
\NewDocumentCommand{\endsolutions}{}{\end{sidebox}}

% PDF 元数据配色
\definecolor{titlecolorcoverpage}{HTML}{e6bf29}
\definecolor{chaptercolor}{HTML}{187d71}
\definecolor{sectioncolor}{HTML}{0c5248}

\hypersetup{
    colorlinks=true,
    linkcolor=chaptercolor,
    citecolor=blue!60!black,
    urlcolor=blue!70!black,
    bookmarksnumbered=true,
    pdfcreator={XeLaTeX + kaobookCJK},
    pdfstartview={FitV},
}

% 灰色背景色设置
\if@backgroundcolor
    \definecolor{bg}{HTML}{fcfcfc}
    \pagecolor{bg}
    \setkomafont{pageheadfoot}{\color{gray}}
\fi

% 代码块增强
\RequirePackage{listings}
% ⚠️ 必须加载 xeCJK-listings：listings 默认把整段当 verbatim 交给
% **单一拉丁字体**排版，块内的中文注释无法参与 xeCJK 的断行与字形整形，
% 于是整段中文变成 null 空字符（正文与边注因此完全正常，只有代码块里的
% 中文注释是方块）。xeCJK-listings 把 lstlisting 接入 xeCJK 管线。
\RequirePackage{xeCJK-listings}
% CJK 用书宋（代码块里的中文注释）。等宽的 \ttfamily 只管拉丁字符，
% 块内中文由 xeCJK-listings 按 \setCJKmonofont 走——cour 无 CJK 字形，
% 故这里显式改用 FZSSJW（方正书宋），保证中文注释能正常显示。
\lstset{
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    frame=single,
    numbers=left,
    numberstyle=\tiny\color{gray},
    backgroundcolor=\color{gray!5},
    keywordstyle=\color{blue!70!black},
    commentstyle=\color{green!50!black},
    stringstyle=\color{red!70!black},
    showstringspaces=false,
    % xeCJK-listings：让 lstlisting 内的中文走 xeCJK 整形（否则整段方块）
    alsoletter=*,
    columns=flexible,
}
% 代码块内的中文注释用方正书宋（有 CJK 字形），Latin 仍走 cour
\setCJKmonofont[Path=\fontpath, Extension=.TTF]{FZSSJW}

% ⚠️ kaobook 自带的 kaolstplain（正文里的 lstlisting 与边栏里嵌套的
%   lstlisting 都用它）在 \kaoCJKsc.sty:922 定义，只设了 basicstyle，
%   没接 xeCJK → 块内中文注释是方块。此处覆盖它，把 CJK 补上。
\lstdefinestyle{kaolstplain}{
    alsoletter=*,
    columns=flexible,
}
\endinput
