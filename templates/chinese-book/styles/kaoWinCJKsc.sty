%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% kaoWinCJKsc.sty — 方正字体配置 + 增强样式
% 字体规范：
%   最大标题：方正小标宋  |  次级标题：方正黑体
%   正文：方正书宋        |  其他板块：方正楷体
%   侧边注释：方正仿宋    |  代码：等宽代码字体
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\ProvidesPackage{kaoWinCJKsc}[2024/01/01 v2.0 FZ Font Config]

% ── 字体路径 ──
% 原为 C:/Windows/Fonts/ + GBK 名（方正书宋_GBK / FZHei-B01 …），
% 换机器即失效，且这些字体的**子集没有拉丁字形**——标题里的数字与英文
% 会整段变 null 空字符（实测 PDF 提取出上千个 \x00）。
% 统一指向项目内嵌字体 templates/fonts/，与 harryopo-base.sty 同一套。
\newcommand{\fontpath}{../fonts/}

% ⚠️ FZ*JW 系列是**单一字重静态字体**（fontTools 实测无 fvar、无 Bold 文件），
%   但 kaobook 会请求 b/n（粗）与 m/it（斜）形状——章节标题 \fzhei\bfseries、
%   \emph 斜体都会触发。xeCJK 找不到就报
%   "Could not resolve font FZFSJW/B"，该字体族注册失败，
%   于是**边注等使用该族的内容回退到主字体 XITS（纯拉丁）**，
%   整段中文找不到字形被丢弃（实测 main.log 85 条 Missing character，
%   全部来自 \marginnote）。
%   正解：用 AutoFakeBold/AutoFakeSlant 让 xeCJK 就地伪造粗斜，
%   而不是去找不存在的字形。
% ⚠️ 同样不要声明 BoldFont=/ItalicFont=——那会让 xeCJK 去找真实字形并失败。
%   实测：声明后 main.pdf 出现 1127 个 \x00；改用 AutoFake 后归零。
% ⚠️⚠️ \newCJKfontfamily 的**语法陷阱**（2026-10-11 定位，691 条 Missing character 的真根因）：
%   可选参数次序是 \newCJKfontfamily[族名]\命令[fontspec特性]{字体}。
%   把特性写在**命令名之前**，整串会被解析成"族名"——于是 13 个声明共用一个
%   垃圾族名互相 Redefining，\fzsong 等命令注册的字体**不带 AutoFakeBold/Slant
%   也不带 Path**。凡是对这些命令的内容再加粗/斜体（\textbf/\emph/边注斜体），
%   xeCJK 解析不到 b/it/bi 形状 → 该族回退到主字体 XITS（纯拉丁）→ 中文
%   Missing character（实测 691 条，全在字体演示块与边注）。最小对照实验：
%   特性在前 = 书宋体A加粗。→ XITS-Bold 全丢；特性在后 = 0 缺失。
\newCJKfontfamily[fzsong]\fzsong[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZSSJW}    %方正书宋
\newCJKfontfamily[fzhei]\fzhei[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZHTJW}     %方正黑体
\newCJKfontfamily[fzkt]\fzkai[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZKTJW}     %方正楷体
\newCJKfontfamily[fzfs]\fzfs[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZFSJW}      %方正仿宋

% ── 方正小标宋（最大标题专用）──
\newCJKfontfamily[fzxbs]\fzxiaobiaosong[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZXBSJW}

% ── 方正黑体（标题用，别名 yh 兼容旧代码）──
\newCJKfontfamily[yh]\yh[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZHTJW}

% ── 装饰字体：项目未内嵌舒体/姚体，回退到内嵌仿宋而非系统字体 ──
\newCJKfontfamily[fzli]\fzli[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZFSJW}
\newCJKfontfamily[fzshti]\fzshti[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZFSJW}
\newCJKfontfamily[fzyao]\fzyao[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZFSJW}

% ── 备用字体族：原为 SimSun/SimHei/KaiTi/FangSong 系统字体，换机器即失效
%   （且这些系统字体缺 CJK 字形时会静默丢字）。一律指向内嵌字体。
%   族名显式注册（song/hei/kai/fs），供 \CJKfamily{...} 按名引用。──
\newCJKfontfamily[song]\song[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZSSJW}
\newCJKfontfamily[hei]\hei[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZHTJW}
\newCJKfontfamily[kai]\kai[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZKTJW}
\newCJKfontfamily[fs]\fs[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZFSJW}

%----------------------------------------------------------------------------------------
% 等宽代码字体（公式/代码用，优先级：Cascadia Code > Consolas > Courier New）
\IfFontExistsTF{Cascadia Code}{%
    \setmonofont[Scale=MatchLowercase]{Cascadia Code}%
}{%
    \IfFontExistsTF{Consolas}{%
        \setmonofont[Scale=MatchLowercase]{Consolas}%
    }{%
        \setmonofont[Scale=MatchLowercase]{Courier New}%
    }%
}
%
% 边注字体：方正仿宋
% ⚠️ \fzfs 后面**必须紧跟 \rmfamily**。
%   \newCJKfontfamily 只声明 CJK 族，对拉丁字体不生效；而 marginnote 的边注
%   盒子会整体切到该族的 latin 分支，导致中文被主字体（本机为 XITS，纯拉丁
%   数学字体）渲染 → 整段中文找不到字形被丢弃。
%   最小复现（scrbook + marginnote + \marginfont）：
%     \marginfont{\fzfs…}              → Missing character 41
%     \marginfont{\fzfs\rmfamily…}    → Missing character 0
%   \rmfamily 把拉丁主字体切回来，xeCJK 才能对中文正确选到 CJK 族。
\renewcommand*{\marginfont}{\fzfs\rmfamily\footnotesize\justifying\frenchspacing}

% ── 修正 @margin@par 中的 normalfont → fzfs ──
%   同理，末尾也要补 \rmfamily。
%   ⚠️ \RaggedRightParindent 的**大写 I 是错的**：ragged2e 定义的是
%   Parindent（小写 i）。写成 ParIndent 会报 Undefined control sequence，
%   并连锁触发 142 处 "Missing number"（第 5 行 \setlength 的参数解析失败）。
\renewcommand{\@margin@par}{%
    \justifying%
    \setlength{\RaggedRightParindent}{0em}%
    \setlength{\parindent}{0em}%
    \setlength{\parskip}{0.5pc}%
    \frenchspacing%
    \fzfs% 方正仿宋
    \rmfamily% 切回拉丁主字体（缺了会让边注中文全部丢失）
    \ttfamily{\CJKfamily{fzfs}}% 边注里的 \url/\texttt 会切到等宽；
    %   xeCJK 此时按**字体名**去解析 CJK 等宽族，而内嵌字体没装进系统，
    %   解析不到就报 "The font FZFSJW cannot be found"（实测 3 处，
    %   全在 yizhexu.tex:18 的边注 \url 上），URL 整段不输出。
    %   显式绑到已注册的字族 \fzfs，绕开字体名查找。
    \footnotesize%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 彩色盒子

\RequirePackage{tcolorbox}
\tcbuselibrary{breakable,skins,hooks,xparse}

\newcommand*\sideboxstyle[1]{%
    \ifstrequal{#1}{simple}{%
        \tikzstyle{boxstyle}=[%
        inner sep=2mm,
        ]%
    }{%
        \ifstrequal{#1}{kao}{%
            \tikzstyle{boxstyle}=[%
            inner sep=2mm,
            rounded corners,
            ]%
        }{%
            \PackageError{kao}{Unknown style given for sidebox: `#1`}{}
        }%
    }%
}

% kaobook 风格双线框
\sideboxstyle{kao}
\tcbset{kaobox/.style={
    enhanced,
    breakable,
    sharp corners,
    frame hidden,
    coltitle=black,
    fonttitle=\bfseries,
    boxrule=0pt,
    boxsep=0pt,
    left=4mm,
    right=2mm,
    top=2mm,
    bottom=2mm,
    borderline horizontal={0.5pt}{0pt}{black},
    borderline horizontal={0.5pt}{3pt}{black},
    attach boxed title to top center={yshift=-2.25mm},%yshift=-2.25mm
    boxed title style={boxrule=0pt,frame hidden,colback=white,left=2mm,right=2mm,top=1mm,bottom=1mm},
}}

\newtcolorbox{sidebox}[2][]{kaobox,title=#2,#1}
\newtcolorbox{sidebox*}[2][]{kaobox,title=#2,#1,float=htb}

\NewDocumentCommand{\solutions}{O{解答}}{%
    \tcbset{kaobox/.append style={borderline horizontal={0.5pt}{0pt}{black!50!white}}}%
    \begin{sidebox}{#1}
}
\NewDocumentCommand{\endsolutions}{}{\end{sidebox}}

% PDF 元数据配色
\definecolor{titlecolorcoverpage}{HTML}{e6bf29}
\definecolor{chaptercolor}{HTML}{187d71}
\definecolor{sectioncolor}{HTML}{0c5248}

\hypersetup{
    colorlinks=true,
    linkcolor=chaptercolor,
    citecolor=blue!60!black,
    urlcolor=blue!70!black,
    bookmarksnumbered=true,
    pdfcreator={XeLaTeX + kaobookCJK},
    pdfstartview={FitV},
}

% 灰色背景色设置
\if@backgroundcolor
    \definecolor{bg}{HTML}{fcfcfc}
    \pagecolor{bg}
    \setkomafont{pageheadfoot}{\color{gray}}
\fi

% 代码块增强
\RequirePackage{listings}
% ⚠️ 必须加载 xeCJK-listings：listings 默认把整段当 verbatim 交给
% **单一拉丁字体**排版，块内的中文注释无法参与 xeCJK 的断行与字形整形，
% 于是整段中文变成 null 空字符（正文与边注因此完全正常，只有代码块里的
% 中文注释是方块）。xeCJK-listings 把 lstlisting 接入 xeCJK 管线。
\RequirePackage{xeCJK-listings}
% CJK 用书宋（代码块里的中文注释）。等宽的 \ttfamily 只管拉丁字符，
% 块内中文由 xeCJK-listings 按 \setCJKmonofont 走——cour 无 CJK 字形，
% 故这里显式改用 FZSSJW（方正书宋），保证中文注释能正常显示。
\lstset{
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    frame=single,
    numbers=left,
    numberstyle=\tiny\color{gray},
    backgroundcolor=\color{gray!5},
    keywordstyle=\color{blue!70!black},
    commentstyle=\color{green!50!black},
    stringstyle=\color{red!70!black},
    showstringspaces=false,
    % xeCJK-listings：让 lstlisting 内的中文走 xeCJK 整形（否则整段方块）
    alsoletter=*,
    columns=flexible,
}
% 代码块内的中文注释用方正书宋（有 CJK 字形），Latin 仍走 cour
% ⚠️ 这里必须写**文件名**而不是字体名 {FZSSJW}。
%   边注（\marginnote）里的内容会被 kaobook 装进 lrbox 延迟到出页时才排，
%   此时 fontspec 按字体名去系统/缓存里查 FZSSJW —— 内嵌字体没有安装到系统，
%   查不到就报 "The font FZSSJW cannot be found"（实测 3 处，全在
%   yizhexu.tex:18 的边注 \url 上）。给完整文件名让 XeTeX 直接按路径加载，
%   绕开字体名查找。
\setCJKmonofont[Path=\fontpath, Extension=.TTF,
  AutoFakeBold=2.4, AutoFakeSlant=0.2]{FZSSJW}

% ⚠️ kaobook 自带的 kaolstplain（正文里的 lstlisting 与边栏里嵌套的
%   lstlisting 都用它）在 \kaoCJKsc.sty:922 定义，只设了 basicstyle，
%   没接 xeCJK → 块内中文注释是方块。此处覆盖它，把 CJK 补上。
\lstdefinestyle{kaolstplain}{
    alsoletter=*,
    columns=flexible,
}

% ⚠️ listings 1.11b（2025/11）与 xeCJK-listings 3.10.6（2026/08）版本错配：
%   新版 listings 已移除内部宏 \lst@setcatcodes，而 xeCJK-listings 的
%   \lst@Init 钩子仍在调用它 → 每个 lstlisting 都报
%   "Undefined control sequence. \lstlisting ->\def \lstenv@name …
%   \lst@setcatcodes"（实测 tuxiangyubiaoge.tex:246 等处）。
%   空实现兜底：新版 listings 里 catcode 由 \lst@Init 自行处理，
%   缺失这一步不影响输出。
\providecommand{\lst@setcatcodes}{}
\endinput
