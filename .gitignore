# 第三方开源参考源码（自带 git 管理，不入主仓库）
opensource-reference/

# 生成产物（编译/渲染输出；官方示例 output/examples 例外，需入库展示）
output/*
!output/examples/
!output/examples/**

# 工具缓存
.mimosa/

# Word 临时锁文件
~$*

# 蒸馏区临时产物
蒸馏区/*.tmp*

# 隐私脱敏（2026-08-30）：测试残留与蒸馏中间产物不入库
蒸馏区/e2e-test/
蒸馏区/distill-output/distill-images/
蒸馏区/*.tmp*.pdf

# office.py 渲染副产物（e2e 转换 tex/pdf，不入库）
templates/**/*-e2e.tex
templates/**/*-e2e.pdf

# 自检样张编译产物（templates/book/selftest-book.* 只入库 .tex 源文件）
templates/book/selftest-book.pdf
templates/book/selftest-book.toc
templates/book/selftest-book.out
templates/book/selftest-book.lof
templates/book/selftest-book.lot
templates/book/build*.log
# book 调试截图（渲染抽帧用，非交付物）
templates/book/shot_*.png

# chinese-book（kaobook 第三方）编译产物：只入库 .tex 源与 styles/
templates/chinese-book/main.pdf
templates/chinese-book/main.lol
templates/chinese-book/main.mw
templates/chinese-book/main.idx
templates/chinese-book/main.bbl
templates/chinese-book/main.blg
templates/chinese-book/main.lof
templates/chinese-book/main.lot
templates/chinese-book/[a-z].log

# 个人开发材料（2026-09-30 出库，仅本地保留）
# 注意：不能用 `/docs/*` —— 它排除的是目录本身，git 不会下降到目录内，
# 后续 `!` 例外对目录内的文件一律无效（assets 画廊图当年就是这样"例外失败"的）。
# 正确做法：只逐条排除要挡的路径，别整体排除 docs/。
/蒸馏区/
/docs/plans/
/docs/research/
/docs/*.md
# 知识库必须入库（README 与 SKILL.md 都链它）。注意：注释要单独一行，
# 写在 `!` 模式后面会被 git 当成模式的一部分。
!/docs/REPO_WIKI.md
/memory/
/.learnings/
/CLAUDE.md
/test-e2e/
/test-e2e-v2/
/test-mineru-output/
/测试区/

# 入库的 docs 内容：
#   docs/assets/       README 效果展示画廊图
#   docs/REPO_WIKI.md  AI 协作知识库（能力清单/API/技术债/复用指引）

# 工具本地配置（不入库）
/.qoder/

# book 链路临时验证文件（codecheck.* 是开发期手写的样式检查样张）
templates/book/codecheck.tex
templates/book/codecheck.pdf
