\newcommand{\inlinecode}[1]{%
    \texttt{\color{MainColor!80!black}#1}%
}

% ============================================================
% 第七部分：图表配置
% ============================================================

\captionsetup{
    font=small,
    labelfont=bf,
    margin=10pt,
    format=hang
}

% ============================================================
% 第八部分：杂项
% ============================================================

\setstretch{1.25}
\tolerance=1000
\emergencystretch=3em

% ============================================================
% 第九部分：统一页眉页脚配置
% ============================================================

% 统一的页眉配置命令（供各文档类调用）
% 参数 #1: 章节标记命令名称（sectionmark / chaptermark）
% 注意：若需自定义章节标记格式（如 chaptermark 显示"第X章"），
%       应在调用本命令之后再 \renewcommand{\chaptermark}[1]{...}，
%       否则本命令内部的 \renewcommand 会覆盖先前的定义。
\newcommand{\harryopo@setup@header}[1]{%
    \fancypagestyle{fancy}{%
        \fancyhf{}%
        \fancyhead[L]{\small\fzkt\@date\quad\ifx\leftmark\@empty\else\textperiodcentered\quad\leftmark\fi}%
        \fancyhead[R]{\small\thepage}%
        \renewcommand{\headrulewidth}{0pt}%
    }%
    \fancypagestyle{plain}{%
        \fancyhf{}%
        \fancyhead[L]{\small\fzkt\@date}%
        \fancyhead[R]{\small\thepage}%
        \renewcommand{\headrulewidth}{0pt}%
    }%
    \expandafter\renewcommand\csname #1\endcsname[1]{\markboth{##1}{}}%
    \pagestyle{fancy}%
}

\endinput
