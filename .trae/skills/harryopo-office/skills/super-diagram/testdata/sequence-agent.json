{
  "type": "sequence",
  "canvas": {"width": 1100, "height": 760, "theme": "dark"},
  "title": "LLM Agent 时序图",
  "subtitle": "用户 → 意图识别 → 检索 → 生成 → 验证 → 输出",
  "participants": [
    {"id": "user", "en": "User", "zh": "用户", "kind": "user"},
    {"id": "gateway", "en": "Gateway", "zh": "API 网关", "kind": "gateway"},
    {"id": "intent", "en": "Intent Classifier", "zh": "意图识别", "kind": "backend"},
    {"id": "retriever", "en": "Retriever", "zh": "检索器", "kind": "backend"},
    {"id": "llm", "en": "LLM", "zh": "大模型", "kind": "db"},
    {"id": "db", "en": "Vector DB", "zh": "向量数据库", "kind": "db"}
  ],
  "messages": [
    {"from": "user", "to": "gateway", "en": "POST /chat", "zh": "发送问题", "time": "0ms"},
    {"from": "gateway", "to": "intent", "en": "classify()", "zh": "请求意图分类"},
    {"from": "intent", "to": "gateway", "en": "IntentResult", "zh": "返回意图 + 置信度", "async": true},
    {"from": "gateway", "to": "retriever", "en": "search(intent)", "zh": "检索相关上下文"},
    {"from": "retriever", "to": "db", "en": "vector_search(k=5)", "zh": "向量检索"},
    {"from": "db", "to": "retriever", "en": "Top-K 结果", "zh": "", "async": true},
    {"from": "retriever", "to": "llm", "en": "retrieve(context)", "zh": "注入上下文"},
    {"from": "llm", "to": "gateway", "en": "LLMOutput", "zh": "生成回复", "async": true},
    {"from": "gateway", "to": "user", "en": "200 OK + Response", "zh": "返回最终答案", "async": true}
  ]
}
